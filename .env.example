# Watchdog Agent — environment variable overrides
# Copy to .env (gitignored) and fill in your values.
# All of these are optional; config.yaml / config.local.yaml takes precedence
# when the variable is not set.

# Prometheus endpoint (if different from config.yaml default)
# WATCHDOG_PROMETHEUS_URL=http://localhost:9090

# OpenCost endpoint (if different from config.yaml default)
# WATCHDOG_OPENCOST_URL=http://localhost:9003

# AI service endpoint (if different from config.yaml default)
# WATCHDOG_AI_SERVICE_URL=http://localhost:8000

# GitHub Personal Access Token — required for Phase 4 GitOps PR generation.
# Create one at https://github.com/settings/tokens with "repo" scope.
# The token must have write access to the infra-manifests repo.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Target repo for GitOps PRs (Phase 4)
# WATCHDOG_INFRA_REPO=mithulpranav24/watchdog-infra
