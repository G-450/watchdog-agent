# Watchdog Agent — environment variable overrides
# The agent reads these from the process environment. Nothing loads a .env
# file, so set them in your shell (PowerShell: $env:NAME = "value").
# Each one overrides the matching config.yaml / config.local.yaml value.

# Prometheus endpoint (if different from config.yaml default)
# WATCHDOG_PROMETHEUS_URL=http://localhost:9090

# OpenCost endpoint (if different from config.yaml default)
# WATCHDOG_OPENCOST_URL=http://localhost:9003

# AI service endpoint (if different from config.yaml default)
# WATCHDOG_AI_SERVICE_URL=http://localhost:8000

# Turn GitOps PR generation on or off (true/false), overrides gitops.enabled.
# Off by default. When on, GITHUB_TOKEN must also be set or the agent leaves it off.
# WATCHDOG_GITOPS_ENABLED=false

# Target repo for GitOps PRs, overrides gitops.repo
# WATCHDOG_GITOPS_REPO=mithulpranav24/watchdog-infra

# GitHub token for GitOps PR generation. Read only from the environment, never
# from config files. Use a fine-grained PAT limited to the target repo with
# Contents: read/write and Pull requests: read/write.
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
